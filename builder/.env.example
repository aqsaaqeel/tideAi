PORT=3001
VITE_API_URL=http://localhost:3001

# Local testing only: default DO PAT when the UI leaves the token field empty (never set in production / public hosts).
# TIDEAI_DEFAULT_DO_TOKEN=dop_v1_...

# Chat model for tideAI codegen (must match https://docs.digitalocean.com/products/inference/details/models/)
# INFERENCE_MODEL=llama3.3-70b-instruct

# Container Registry: when GET /v2/registry returns 404, tideAI POSTs a new registry (default tier: starter).
# TIDEAI_AUTO_CREATE_REGISTRY=false
# DO_REGISTRY_SUBSCRIPTION_TIER=starter
# DO_REGISTRY_NAME_PREFIX=tideai
# DO_REGISTRY_REGION=nyc3
# TIDEAI_CADDY_URL=https://github.com/caddyserver/caddy/releases/download/v2.8.4/caddy_2.8.4_linux_amd64.tar.gz

# Optional: separate PAT used only for DOCR (registry API + image push). If unset, each build's `do_token` is used.
# Must belong to the same DO team as the user's `do_token` so registry names line up.
# TIDEAI_DOCR_TOKEN=dop_v1_...

# DOCR image repo (one segment). Starter tier = **only 1 repository** per registry — all builds reuse this repo with unique tags.
# If your registry already has a repo, set this to that name or delete the old repo in the DO UI.
# TIDEAI_DOCR_REPO_NAME=tideai-apps

# Only for deploy_mode "github" (POST body or server default):
# GITHUB_TOKEN=ghp_...
# TIDEAI_GITHUB_TOKEN=
